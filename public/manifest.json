{
    "manifest_version": 3,
    "name": "Hệ Thống Quét & In Hàng Loạt",
    "version": "1.0",
    "description": "Quét các tab hiện tại và kích hoạt in khổ A7 căn giữa",
    "permissions": ["tabs", "scripting", "activeTab"],
    "action": {
        "default_popup": "extension-print.html",
        "default_icon": {
            "16": "/favicon.ico",
            "48": "/favicon.ico",
            "128": "/favicon.ico"
        }
    }
}
